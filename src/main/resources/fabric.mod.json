{
	"schemaVersion": 1,
	"id": "elytratrackermod",
	"version": "${version}",
	"name": "Elytra Tracker Mod",
	"description": "This is a mod that adds a UI element to track equipped elytra durability.",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/elytratrackermod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.colin.elytratrackermod.ElytraTrackerMod"
		],
		"fabric-datagen": [
			"com.colin.elytratrackermod.ElytraTrackerModDataGenerator"
		],
		"client": [
			"com.colin.elytratrackermod.ElytraTrackerModClient"
		]
	},
	"mixins": [
		"elytratrackermod.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
